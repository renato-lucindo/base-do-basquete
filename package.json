{
  "name": "base-do-basquete",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --env preview --outdir dist/worker",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260821.1",
    "typescript": "7.0.2",
    "wrangler": "4.125.0"
  }
}
