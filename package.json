{
  "name": "base-do-basquete",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "benchmark:public": "node scripts/benchmark-public.mjs",
    "build": "npm run prepare:sienna && react-router build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:runbooks && npm run build && npm run scan:secrets",
    "check:runbooks": "node scripts/check-runbooks.mjs",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "dev": "npm run prepare:sienna && react-router dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "postinstall": "npm run typegen",
    "prepare:sienna": "node scripts/prepare-sienna.mjs",
    "preview": "npm run build && vite preview",
    "preview:upload": "npm run build && wrangler versions upload --env preview",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "smoke:mvp": "node scripts/smoke-mvp-release.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run typegen && tsc -b",
    "typegen": "wrangler types worker-configuration.d.ts --env preview && react-router typegen",
    "types:check": "wrangler types worker-configuration.d.ts --env preview --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sienna-accessibility": "2.2.333",
    "unpdf": "1.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "1.55.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.134.0"
  }
}
