{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "base-do-basquete-preview",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "vars": {
    "APP_ENV": "preview",
    "PREVIEW_PASSWORD_AUTH": "enabled"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "base-do-basquete-preview",
      "workers_dev": true,
      "preview_urls": true,
      "secrets": {
        "required": ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "SESSION_SECRET"]
      },
      "vars": {
        "APP_ENV": "preview",
        "PREVIEW_PASSWORD_AUTH": "enabled"
      }
    },
    "production": {
      "name": "base-do-basquete-prod",
      "workers_dev": true,
      "preview_urls": false,
      "secrets": {
        "required": ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "SESSION_SECRET"]
      },
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
