{
  "files": {
    "includes": [
      "**",
      "!worker-configuration.d.ts",
      "!build",
      "!coverage",
      "!node_modules",
      "!.react-router",
      "!.wrangler",
      "!docs/plan/referencias",
      "!public/vendor/sienna"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
